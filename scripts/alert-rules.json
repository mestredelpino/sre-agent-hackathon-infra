[
  {
    "alert": "DeploymentReplicasUnavailable",
    "expression": "(kube_deployment_spec_replicas{namespace=~\"${NAMESPACES}\"} > 0) and on(cluster, namespace, deployment) (kube_deployment_status_replicas_available < kube_deployment_spec_replicas)",
    "for": "PT5M",
    "severity": 1,
    "summary": "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} has unavailable replicas."
  },
  {
    "alert": "StatefulSetReplicasUnavailable",
    "expression": "kube_statefulset_replicas{namespace=~\"${NAMESPACES}\"} > on(cluster, namespace, statefulset) kube_statefulset_status_replicas_ready",
    "for": "PT5M",
    "severity": 1,
    "summary": "StatefulSet {{ $labels.namespace }}/{{ $labels.statefulset }} has unavailable replicas."
  },
  {
    "alert": "PodPending",
    "expression": "kube_pod_status_phase{namespace=~\"${NAMESPACES}\",phase=\"Pending\"} == 1",
    "for": "PT5M",
    "summary": "Pod {{ $labels.namespace }}/{{ $labels.pod }} has remained Pending."
  },
  {
    "alert": "ContainerRestartBurst",
    "expression": "increase(kube_pod_container_status_restarts_total{namespace=~\"${NAMESPACES}\"}[15m]) > 3",
    "for": "PT1M",
    "summary": "Container {{ $labels.container }} in {{ $labels.namespace }}/{{ $labels.pod }} restarted repeatedly."
  },
  {
    "alert": "ContainerWaitingFailure",
    "expression": "kube_pod_container_status_waiting_reason{namespace=~\"${NAMESPACES}\",reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError\"} == 1",
    "for": "PT5M",
    "summary": "Container {{ $labels.container }} is waiting: {{ $labels.reason }}."
  },
  {
    "alert": "PersistentVolumeSpaceLow",
    "expression": "(100 * kubelet_volume_stats_used_bytes{namespace=~\"${NAMESPACES}\"} / kubelet_volume_stats_capacity_bytes > 85) and (kubelet_volume_stats_capacity_bytes > 0)",
    "for": "PT10M",
    "summary": "PVC {{ $labels.namespace }}/{{ $labels.persistentvolumeclaim }} exceeds 85 percent capacity."
  },
  {
    "alert": "KubernetesMetricsMissing",
    "expression": "absent(kube_node_info)",
    "for": "PT15M",
    "severity": 1,
    "summary": "Kubernetes node metrics are missing from the cluster-scoped rule group."
  }
]